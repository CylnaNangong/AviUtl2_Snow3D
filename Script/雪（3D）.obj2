--group

--------------------------------------------------------------------
-- 雪（3D）
--   ・3D空間上に粒子を発生させ、重力・風・揺らぎで運動させる
--   ・各粒子はカメラに正対するビルボードとして描画する
--   ・粒子の絵柄は AviUtl2 標準の図形（円/四角形/三角/星/心…）を
--     そのままテクスチャとして使用する
--   ・頂点座標にZを持つため、カメラ制御の透視投影が効く
--   ・シミュレーションは obj.time の純関数なのでシークしても破綻しない
--------------------------------------------------------------------


--[[pixelshader@ps_snow_shape_blur:
Texture2D<float4> Src : register(t0);
cbuffer SnowCB : register(b0) { float4 dims; float4 cfg; };
// dims=source width,height,output width,height
// cfg=axis(0 horizontal+pad,1 vertical),sigma,radius,pad
float4 read_safe(int2 q) {
    if (q.x < 0 || q.y < 0 || q.x >= (int)dims.x || q.y >= (int)dims.y)
        return float4(0,0,0,0);
    return Src.Load(int3(q,0));
}
float4 ps_snow_shape_blur(float4 pos : SV_Position) : SV_Target {
    int2 p = int2(pos.xy);
    int2 base = p;
    if (cfg.x < 0.5) base -= int2((int)cfg.w,(int)cfg.w);
    float4 sum = float4(0,0,0,0);
    float total = 0;
    [loop] for (int j=-72; j<=72; ++j) {
        if (abs(j) > (int)cfg.z) continue;
        float w = exp(-0.5*j*j/max(cfg.y*cfg.y,0.0001));
        int2 delta = cfg.x < 0.5 ? int2(j,0) : int2(0,j);
        sum += read_safe(base+delta)*w;
        total += w;
    }
    return sum/max(total,0.00001);
}
]]

local obj, math = obj, math

_G._SNOW3D_PERSIST = _G._SNOW3D_PERSIST or {}
local _SNOW_PERSIST = _G._SNOW3D_PERSIST

local function as_bool(v, def)
    if v == nil then return def end
    if type(v) == "boolean" then return v end
    if type(v) == "number" then return v ~= 0 end
    if type(v) == "string" then
        return v == "1" or v:lower() == "true"
    end
    return def
end

local function snow_utf8_to_u16(ffi, s)
    local codes = {}
    local i, n = 1, #s
    while i <= n do
        local b1 = s:byte(i)
        local cp
        if b1 < 0x80 then cp = b1; i = i + 1
        elseif b1 < 0xE0 and i + 1 <= n then cp = (b1 - 0xC0) * 64 + (s:byte(i + 1) - 0x80); i = i + 2
        elseif b1 < 0xF0 and i + 2 <= n then cp = (b1 - 0xE0) * 4096 + (s:byte(i + 1) - 0x80) * 64 + (s:byte(i + 2) - 0x80); i = i + 3
        elseif i + 3 <= n then cp = (b1 - 0xF0) * 262144 + (s:byte(i + 1) - 0x80) * 4096 + (s:byte(i + 2) - 0x80) * 64 + (s:byte(i + 3) - 0x80); i = i + 4
        else cp = 0x3F; i = i + 1 end
        if cp >= 0x10000 then
            cp = cp - 0x10000
            codes[#codes + 1] = 0xD800 + math.floor(cp / 1024)
            codes[#codes + 1] = 0xDC00 + (cp % 1024)
        else
            codes[#codes + 1] = cp
        end
    end
    local buf = ffi.new("uint16_t[?]", #codes + 1)
    for k = 1, #codes do buf[k - 1] = codes[k] end
    buf[#codes] = 0
    return buf
end

local function snow_u16_to_utf8(ffi, wptr, nlen)
    local p = ffi.cast("const uint16_t*", wptr)
    local out = {}
    local i = 0
    while i < nlen do
        local u = p[i]
        if u == 0 then break end
        if u >= 0xD800 and u <= 0xDBFF and i + 1 < nlen then
            local u2 = p[i + 1]
            if u2 >= 0xDC00 and u2 <= 0xDFFF then
                u = 0x10000 + (u - 0xD800) * 1024 + (u2 - 0xDC00)
                i = i + 1
            end
        end
        i = i + 1
        if u < 0x80 then out[#out + 1] = string.char(u)
        elseif u < 0x800 then out[#out + 1] = string.char(0xC0 + math.floor(u / 64), 0x80 + (u % 64))
        elseif u < 0x10000 then out[#out + 1] = string.char(0xE0 + math.floor(u / 4096), 0x80 + (math.floor(u / 64) % 64), 0x80 + (u % 64))
        else out[#out + 1] = string.char(0xF0 + math.floor(u / 262144), 0x80 + (math.floor(u / 4096) % 64), 0x80 + (math.floor(u / 64) % 64), 0x80 + (u % 64)) end
    end
    return table.concat(out)
end

local function snow_get_w32_io()
    if type(_G.VL3D_TEST_W32_API) == "table" then return _G.VL3D_TEST_W32_API end
    local api = _SNOW_PERSIST.w32_io
    if api ~= nil then return api or nil end
    api = false
    pcall(function()
        local ok_f, ffi = pcall(require, "ffi")
        if not (ok_f and ffi ~= nil and ffi.os == "Windows") then return end
        pcall(ffi.cdef, "void* GetModuleHandleA(const char*); void* GetProcAddress(void*, const char*);")
        local gmh = ffi.cast("void* (__stdcall *)(const char*)", ffi.C.GetModuleHandleA)
        local gpa = ffi.cast("void* (__stdcall *)(void*, const char*)", ffi.C.GetProcAddress)
        local k32 = gmh("kernel32.dll")
        if k32 == nil then return end
        local p_cf = gpa(k32, "CreateFileW")
        local p_rf = gpa(k32, "ReadFile")
        local p_ch = gpa(k32, "CloseHandle")
        local p_ge = gpa(k32, "GetEnvironmentVariableW")
        local p_gm = gpa(k32, "GetModuleFileNameW")
        if p_cf ~= nil and p_rf ~= nil and p_ch ~= nil then
            api = {
                CreateFileW = ffi.cast("intptr_t (__stdcall *)(const uint16_t*, uint32_t, uint32_t, void*, uint32_t, uint32_t, void*)", p_cf),
                ReadFile    = ffi.cast("int (__stdcall *)(intptr_t, void*, uint32_t, uint32_t*, void*)", p_rf),
                CloseHandle = ffi.cast("int (__stdcall *)(intptr_t)", p_ch),
                GetEnvW     = p_ge ~= nil and ffi.cast("uint32_t (__stdcall *)(const uint16_t*, uint16_t*, uint32_t)", p_ge) or nil,
                GetModW     = p_gm ~= nil and ffi.cast("uint32_t (__stdcall *)(void*, uint16_t*, uint32_t)", p_gm) or nil,
            }
        end
    end)
    _SNOW_PERSIST.w32_io = api
    return api or nil
end

local function snow_read_file_utf8(path_utf8)
    if type(path_utf8) ~= "string" or #path_utf8 == 0 then return nil end
    if type(io) == "table" and type(io.open) == "function" then
        local fh = io.open(path_utf8, "rb")
        if fh ~= nil then
            local d = fh:read("*a")
            fh:close()
            if type(d) == "string" and #d > 0 then return d end
        end
    end
    local out = nil
    pcall(function()
        local ok_f, ffi = pcall(require, "ffi")
        if not (ok_f and ffi ~= nil) then return end
        local api = snow_get_w32_io()
        if not api then return end
        local wbuf = snow_utf8_to_u16(ffi, path_utf8)
        local hf = tonumber(api.CreateFileW(wbuf, 0x80000000, 7, nil, 3, 0x80, nil)) or -1
        if hf == 0 or hf == -1 then return end
        local buf = ffi.new("uint8_t[65536]")
        local rd = ffi.new("uint32_t[1]")
        if api.ReadFile(hf, buf, 65536, rd, nil) ~= 0 and rd[0] > 0 then
            out = ffi.string(buf, rd[0])
        end
        api.CloseHandle(hf)
    end)
    return out
end

local function snow_get_win_dirs()
    local pdata, exe_dir = nil, nil
    if type(os) == "table" and type(os.getenv) == "function" then
        pdata = os.getenv("ProgramData")
    end
    pcall(function()
        local ok_f, ffi = pcall(require, "ffi")
        if not (ok_f and ffi ~= nil) then return end
        local api = snow_get_w32_io()
        if not api then return end
        if (type(pdata) ~= "string" or #pdata == 0) and api.GetEnvW ~= nil then
            local wn = snow_utf8_to_u16(ffi, "ProgramData")
            local wbuf = ffi.new("uint16_t[520]")
            local n = tonumber(api.GetEnvW(wn, wbuf, 519)) or 0
            if n > 0 and n < 519 then pdata = snow_u16_to_utf8(ffi, wbuf, n) end
        end
        if api.GetModW ~= nil then
            local mbuf = ffi.new("uint16_t[1024]")
            local mn = tonumber(api.GetModW(nil, mbuf, 1023)) or 0
            if mn > 0 and mn < 1023 then
                local full = snow_u16_to_utf8(ffi, mbuf, mn)
                exe_dir = full:match("^(.*)[/\\][^/\\]+$")
            end
        end
    end)
    return pdata, exe_dir
end

local function snow_detect_ui_lang()
    if type(_SNOW_PERSIST.ui_lang) == "string" then
        return _SNOW_PERSIST.ui_lang
    end
    local ui_lang = "ja"
    pcall(function()
        local paths = {}
        local sp = nil
        pcall(function() sp = obj.getinfo("script_path") end)
        if type(sp) == "string" and #sp > 0 then
            local sep = sp:sub(-1)
            if sep ~= "\\" and sep ~= "/" then sp = sp .. "/" end
            paths[#paths + 1] = sp .. "../aviutl2.ini"
            paths[#paths + 1] = sp .. "../../aviutl2.ini"
            paths[#paths + 1] = sp .. "..\\aviutl2.ini"
            paths[#paths + 1] = sp .. "..\\..\\aviutl2.ini"
        end
        local pdata, exe_dir = snow_get_win_dirs()
        if type(exe_dir) == "string" and #exe_dir > 0 then
            paths[#paths + 1] = exe_dir .. "\\aviutl2.ini"
            paths[#paths + 1] = exe_dir .. "\\data\\aviutl2.ini"
        end
        if type(pdata) == "string" and #pdata > 0 then
            paths[#paths + 1] = pdata .. "\\aviutl2\\aviutl2.ini"
        end
        paths[#paths + 1] = "C:\\ProgramData\\aviutl2\\aviutl2.ini"
        for i = 1, #paths do
            local content = snow_read_file_utf8(paths[i])
            if type(content) == "string" and #content > 0 then
                for line in content:gmatch("[^\r\n]+") do
                    local val = line:match("^%s*[Ll]anguage%s*=%s*(.-)%s*$")
                    if val ~= nil then
                        local s = val:match("^%s*(.-)%s*$") or ""
                        local low = s:lower()
                        if s == "" then
                            ui_lang = "ja"
                        elseif s:find("中", 1, true) or s:find("简", 1, true) or s:find("簡", 1, true) or s:find("繁", 1, true)
                            or low:find("chinese", 1, true) or low == "zh" or low == "cn" or low == "chs" or low == "cht"
                            or low:find("^zh[_%-%. ]") or low:find("[_%-%. ]zh$") or low:find("[_%-%. ]cn$") then
                            ui_lang = "zh"
                        elseif s:find("德", 1, true) or s:find("独", 1, true)
                            or low:find("deutsch", 1, true) or low:find("german", 1, true)
                            or low == "de" or low == "deu" or low == "ger"
                            or low:find("^de[_%-%. ]") or low:find("[_%-%. ]de$")
                            or low:find("[_%-%. ]de[_%-%. ]") then
                            ui_lang = "de"
                        elseif low == "default" or s:find("日本", 1, true) or low:find("japanese", 1, true) or low:find("japan", 1, true)
                            or low == "ja" or low == "jp" or low == "jpn"
                            or low:find("^ja[_%-%. ]") or low:find("[_%-%. ]ja$") or low:find("[_%-%. ]jp$") then
                            ui_lang = "ja"
                        else
                            ui_lang = "en"
                        end
                        break
                    end
                end
                break
            end
        end
    end)
    _SNOW_PERSIST.ui_lang = ui_lang
    return ui_lang
end

------------------------------------------------------------
-- 設定値の読み取り
--   ※ Lua/LuaJIT は 1 関数あたり 200 ローカルまで。AviUtl2 は設定項目の数だけ
--     先頭に local を差し込んでくるので、ここは 1 個のテーブルにまとめる。
--   AviUtl2 側で項目が読めなかった場合でも描画が止まらないよう、
--   ここで必ず既定値を入れてから使う。
------------------------------------------------------------
local P = {}
P.count = count or 400
P.size = psize or 8
if type(P.size) ~= "number" then P.size = 8 end
if P.size < 0.1 then P.size = 0.1 end
P.size_var = size_var or 50
P.fig = fig or "円"
P.color = snow_color or 0xffffff
P.soft = soft or 100
P.vel_x = vel_x or 0
P.vel_y = vel_y or 200
P.vel_z = vel_z or 0
P.gravity = gravity or 400
P.wind_x = wind_x or 0
P.wind_y = wind_y or 0
P.wind_z = wind_z or 0
P.sway = sway or 30
P.sway_rate = sway_speed or 2
P.spin = spin or 90
P.spread = spread or 25
P.area_w = area_w or 1920
P.area_h = area_h or 1080
P.area_d = area_d or 1500
P.area_x = area_x or 0
P.area_y = area_y or 0
P.area_z = area_z or 0
P.follow = as_bool(follow, true)
P.world_fixed = as_bool(world_fixed, true)
P.sync_size = as_bool(sync_size, false)
P.fit_view = as_bool(fit_view, false)
P.margin = margin or 20
P.wrap_soft = wrap_soft or 40
if P.wrap_soft < 0 then P.wrap_soft = 0 elseif P.wrap_soft > 100 then P.wrap_soft = 100 end
P.wrap_soft_k = P.wrap_soft / 100 * 6     -- フェード幅 = 粒径 × この値
P.show_box = as_bool(show_box, false)
P.auto_life = as_bool(auto_life, true)
P.life = life_sec or 6
P.fade_in = fade_in or 10
P.fade_out = fade_out or 30
P.depth_fade = depth_fade or 30
P.sort = as_bool(sort_depth, true)
P.log_mode = as_bool(log_mode, true)
P.seed = seed or 0
P.near_cull = as_bool(near_cull, false)
P.near_dist = near_dist or 150
if P.near_dist < 0 then P.near_dist = 0 end

------------------------------------------------------------
-- 本体
--   Lua/LuaJIT は 1 関数あたりのローカルが 200 個まで。
--   AviUtl2 は設定項目の数だけ先頭に local を差し込んでくるため、
--   本体を関数にまとめてローカル空間を分けている。
------------------------------------------------------------
-- Continuous view-angle feather; no previous-frame state.
local function snow_axis_feather(f, short_width, deep_width)
    local t = math.max(0, math.min(1, (math.abs(f) - 0.5) / 0.4))
    t = t * t * (3 - 2 * t)
    return short_width + (math.max(short_width, deep_width) - short_width) * t
end

local function snow3d_frame()

    ------------------------------------------------------------
    -- 決定的な擬似乱数
    --   (粒子番号, 世代, 用途) から値を求める小型ハッシュ。
    --   同じ時間なら必ず同じ値になるので、シークしても破綻しない。
    --   隣り合う種の相関で粒子が筋状に並ばないよう、
    --   乗算＋二乗で撹拌している（ビット演算を使わないので
    --   LuaJIT / Lua 5.4 のどちらでも同じ結果になる）。
    ------------------------------------------------------------
    local HASH_P = 67108859      -- 2^26 未満の素数
    local function rand01(a, b, c)
        local x = (a * 196613 + b * 104729 + c * 51949 + P.seed * 7919 + 12345) % HASH_P
        x = (x * 40503 + 9973) % HASH_P
        x = (x * x + 3) % HASH_P
        x = (x * x + 11) % HASH_P
        return x / HASH_P
    end

    ------------------------------------------------------------
    -- 設定値の整理
    ------------------------------------------------------------
    local num = math.floor(P.count + 0.5)
    if num < 1 then num = 1 end
    if num > 4000 then num = 4000 end

    local base_size = P.size
    if base_size < 0.1 then base_size = 0.1 end
    local var_size = P.size_var / 100

    -- 不透明度は「標準属性」の値だけを使う（このオブジェクトには持たない）
    --   フレームバッファへ直接描くので、標準側の値を自分で掛ける必要がある
    local base_alpha = obj.alpha or 1
    if base_alpha < 0 then base_alpha = 0 elseif base_alpha > 1 then base_alpha = 1 end

    local col_r = math.floor(P.color / 0x10000) % 0x100 / 255
    local col_g = math.floor(P.color / 0x100) % 0x100 / 255
    local col_b = P.color % 0x100 / 255

    -- 運動のベクトル化
    --   Y は AviUtl 座標系と同じく「プラスが下方向」。
    --   初速Y = +200  → 下向きに 200px/秒（普通の雪）
    --   初速Y = -200  → 上向きに 200px/秒（上昇する塵）
    --   重力  = +400  → 下向きに加速（普通の雪）
    --   重力  = -400  → 上向きに加速（加速しながら昇る粒子）
    --   風    = (X, Y, Z) の一定速度を全粒子に足す
    local vel0_x = P.vel_x
    local vel0_y = P.vel_y
    local vel0_z = P.vel_z
    local grav   = P.gravity
    local wind_x = P.wind_x
    local wind_y = P.wind_y
    local wind_z = P.wind_z

    local vel_len = math.sqrt(vel0_x * vel0_x + vel0_y * vel0_y + vel0_z * vel0_z)

    -- 進行方向の単位ベクトル d（発生面と寿命の計算に使う）
    --   初速が 0 のときは重力の向き、それも 0 なら真下を使う
    local d_x, d_y, d_z = 0, 1, 0
    if vel_len > 1e-6 then
        d_x, d_y, d_z = vel0_x / vel_len, vel0_y / vel_len, vel0_z / vel_len
    elseif math.abs(grav) > 1e-6 then
        d_y = 1
        if grav < 0 then d_y = -1 end
    end

    -- d に垂直な基底（初速のばらつきを円錐状に散らすため）
    local e1_x, e1_y, e1_z, e2_x, e2_y, e2_z
    do
        local hx, hy, hz
        if math.abs(d_y) < 0.9 then hx, hy, hz = 0, 1, 0 else hx, hy, hz = 1, 0, 0 end
        local ax = d_y * hz - d_z * hy
        local ay = d_z * hx - d_x * hz
        local az = d_x * hy - d_y * hx
        local al = math.sqrt(ax * ax + ay * ay + az * az)
        if al < 1e-6 then ax, ay, az, al = 1, 0, 0, 1 end
        e1_x, e1_y, e1_z = ax / al, ay / al, az / al
        e2_x = d_y * e1_z - d_z * e1_y
        e2_y = d_z * e1_x - d_x * e1_z
        e2_z = d_x * e1_y - d_y * e1_x
    end

    -- 進行方向に沿った加速度（寿命の計算用）
    local acc_d = grav * d_y

    local sway_amp = P.sway
    local sway_w = 2 * math.pi * P.sway_rate
    local spin_v = P.spin * math.pi / 180

    local spread_v = P.spread * math.pi / 180
    if spread_v > 1.4835 then spread_v = 1.4835 end   -- 85度まで
    local spread_k = math.tan(spread_v)

    local box_w = P.area_w
    local box_h = P.area_h
    local box_d = P.area_d
    if P.sync_size then
        -- 画面（合成プロジェクト）のサイズに合わせる（カスタムオブジェクトでは obj.screen_w/h を優先）
        --   3840x2160 や 4000x4000 の合成でも画面全体に雪が広がる
        local fw, fh = obj.screen_w, obj.screen_h
        if type(fw) ~= "number" or fw < 1 then fw = obj.w end
        if type(fh) ~= "number" or fh < 1 then fh = obj.h end
        if type(fw) ~= "number" or fw < 1 then fw = box_w end
        if type(fh) ~= "number" or fh < 1 then fh = box_h end
        local mk = 1 + P.margin / 100
        box_w = fw * mk
        box_h = fh * mk
    end
    if box_w < 1 then box_w = 1 end
    if box_h < 1 then box_h = 1 end
    if box_d < 1 then box_d = 1 end

    local fin = P.fade_in / 100
    local fout = P.fade_out / 100
    if fin < 0.001 then fin = 0.001 end
    if fout < 0.001 then fout = 0.001 end
    if fin + fout > 0.98 then
        local sc = 0.98 / (fin + fout)
        fin = fin * sc
        fout = fout * sc
    end

    local dfade = P.depth_fade / 100
    if dfade < 0 then dfade = 0 elseif dfade > 1 then dfade = 1 end

    ------------------------------------------------------------
    -- カメラ制御の基底ベクトル（前方・右・上）
    --   ※ cam == nil（カメラ制御なし）のときも AviUtl2 標準透視投影の視点 (0, 0, -1024) を基準にする
    ------------------------------------------------------------
    local cam = nil
    pcall(function() cam = obj.getoption("camera_param") end)
    local cam_x, cam_y, cam_z = 0, 0, -1024
    local f_x, f_y, f_z = 0, 0, 1     -- カメラから見た前方
    local r_x, r_y, r_z = 1, 0, 0     -- 画面の右
    local u_x, u_y, u_z = 0, -1, 0    -- 画面の上（AviUtlは+Yが下方向）
    local cam_target_degenerate = false

    if cam ~= nil then
        cam_x = cam.x or 0
        cam_y = cam.y or 0
        cam_z = cam.z or -1024

        local dx = (cam.tx or 0) - cam_x
        local dy = (cam.ty or 0) - cam_y
        local dz = (cam.tz or 0) - cam_z
        local len = math.sqrt(dx * dx + dy * dy + dz * dz)
        if len < 1e-4 then
            cam_target_degenerate = true
        end
        if len < 1e-6 then
            dx, dy, dz, len = 0, 0, 1, 1
        end
        f_x, f_y, f_z = dx / len, dy / len, dz / len

        local t_x = cam.ux or 0
        local t_y = cam.uy or 0
        local t_z = cam.uz or 0
        if t_x * t_x + t_y * t_y + t_z * t_z < 1e-9 then
            t_x, t_y, t_z = 0, -1, 0
        end

        -- right = forward x up
        local a_x = f_y * t_z - f_z * t_y
        local a_y = f_z * t_x - f_x * t_z
        local a_z = f_x * t_y - f_y * t_x
        local al = math.sqrt(a_x * a_x + a_y * a_y + a_z * a_z)
        if al < 1e-6 then
            a_x, a_y, a_z, al = 1, 0, 0, 1
        end
        r_x, r_y, r_z = a_x / al, a_y / al, a_z / al

        -- up = right x forward
        u_x = r_y * f_z - r_z * f_y
        u_y = r_z * f_x - r_x * f_z
        u_z = r_x * f_y - r_y * f_x

        -- カメラ Z 軸ロール角 cam.rz（u = -d のため r' = r*cr - u*sr, u' = r*sr + u*cr）
        if type(cam.rz) == "number" and math.abs(cam.rz) > 1e-5 then
            local cr = math.cos(math.rad(cam.rz))
            local sr = math.sin(math.rad(cam.rz))
            local nr_x, nr_y, nr_z = r_x * cr - u_x * sr, r_y * cr - u_y * sr, r_z * cr - u_z * sr
            local nu_x, nu_y, nu_z = r_x * sr + u_x * cr, r_y * sr + u_y * cr, r_z * sr + u_z * cr
            r_x, r_y, r_z = nr_x, nr_y, nr_z
            u_x, u_y, u_z = nu_x, nu_y, nu_z
        end
    end

    ------------------------------------------------------------
    -- 発生領域の中心
    ------------------------------------------------------------
    local c_x, c_y, c_z = P.area_x, P.area_y, P.area_z
    if P.follow and cam ~= nil then
        -- カメラ制御の注視点に領域を寄せる
        --   ※「目標レイヤー」にカメラ制御自身のレイヤーを指定した場合（目標基準＝カメラ座標）等で
        --     注視点とカメラ座標が一致（距離 0）しているときは、レンズ前方 cam.d（既定 1024）を基準注視点とする。
        local zoom = obj.zoom or 1
        if zoom == nil or zoom < 1e-6 then zoom = 1 end
        local eff_tx, eff_ty, eff_tz = cam.tx or 0, cam.ty or 0, cam.tz or 0
        if cam_target_degenerate then
            local cam_d_ref = (type(cam.d) == "number" and cam.d >= 1) and cam.d or 1024
            eff_tx = cam_x + f_x * cam_d_ref
            eff_ty = cam_y + f_y * cam_d_ref
            eff_tz = cam_z + f_z * cam_d_ref
        end
        c_x = (eff_tx - (obj.x or 0)) / zoom + P.area_x
        c_y = (eff_ty - (obj.y or 0)) / zoom + P.area_y
        c_z = (eff_tz - (obj.z or 0)) / zoom + P.area_z
    end

    -- 世界座標に固定するモード
    --   発生位置はカメラではなくオブジェクト基準の固定点に置き、
    --   出来上がった位置をカメラ中心の箱へ折り返して表示する。
    --   こうするとカメラが動いても粒子の軌道は変わらず、
    --   なおかつカメラの前には必ず雪が存在する。
    local wrapping = false
    local a_x, a_y, a_z = c_x, c_y, c_z
    if P.world_fixed and P.follow and cam ~= nil then
        wrapping = true
        a_x, a_y, a_z = P.area_x, P.area_y, P.area_z
    end

    -- オブジェクトのローカル→ワールド変換パラメータ
    local ozm = (type(obj.zoom) == "number" and obj.zoom > 1e-6) and obj.zoom or 1
    local ox0, oy0, oz0 = (obj.x or 0), (obj.y or 0), (obj.z or 0)

    -- 奥行き減衰の基準（ローカル c をワールド座標へ戻してからカメラ距離を算出）
    local c_d = ((c_x * ozm + ox0) - cam_x) * f_x
              + ((c_y * ozm + oy0) - cam_y) * f_y
              + ((c_z * ozm + oz0) - cam_z) * f_z

    ------------------------------------------------------------
    -- 画面に見えている範囲（折り返し箱の大きさを決めるのに使う）
    --   drawpoly の座標は「オブジェクトのローカル座標」なので、
    --   画面に写る範囲は 焦点距離 d と オブジェクトの拡大率 zoom と
    --   カメラからの距離で決まる。箱がこれより小さいと、箱の壁
    --   （＝折り返しで薄くなる帯）が画面の中に入って「断层」になる。
    ------------------------------------------------------------
    local vis_w, vis_h = 0, 0
    if cam ~= nil then
        local dz = cam.d or 1024
        if type(dz) ~= "number" or dz < 1 then dz = 1024 end
        local zoom = ozm
        local fw, fh = obj.screen_w, obj.screen_h
        if type(fw) ~= "number" or fw < 1 then fw = obj.w end
        if type(fh) ~= "number" or fh < 1 then fh = obj.h end
        if type(fw) ~= "number" or fw < 1 then fw = 1920 end
        if type(fh) ~= "number" or fh < 1 then fh = 1080 end
        local world_hd = (box_d * zoom) * 0.5
        local near_s = c_d - world_hd
        if near_s < 1 then near_s = 1 end
        local far_s = c_d + world_hd
        if far_s < near_s then far_s = near_s end
        vis_w = fw * far_s / (zoom * dz)
        vis_h = fh * far_s / (zoom * dz)

        -- 壁を画面の外へ
        --   画面に見えている視錐台（8 隅）をワールド座標で求めて、
        --   ローカル折り返し箱へ逆変換して広げる。縮めはしない。
        if P.fit_view then
            local mnx, mxx = 1e30, -1e30
            local mny, mxy = 1e30, -1e30
            local mnz, mxz = 1e30, -1e30
            for _, sc in ipairs({ near_s, far_s }) do
                local ex = (fw * 0.5) * sc / dz
                local ey = (fh * 0.5) * sc / dz
                for _, sx in ipairs({ -1, 1 }) do
                    for _, sy in ipairs({ -1, 1 }) do
                        local wx = cam_x + f_x * sc + r_x * ex * sx + u_x * ey * sy
                        local wy = cam_y + f_y * sc + r_y * ex * sx + u_y * ey * sy
                        local wz = cam_z + f_z * sc + r_z * ex * sx + u_z * ey * sy
                        if wx < mnx then mnx = wx end
                        if wx > mxx then mxx = wx end
                        if wy < mny then mny = wy end
                        if wy > mxy then mxy = wy end
                        if wz < mnz then mnz = wz end
                        if wz > mxz then mxz = wz end
                    end
                end
            end
            -- 視線に平行な軸は「奥行き」なので触らない（ワールド AABB → ローカル座標へ逆変換）
            if math.abs(f_x) < 0.8 and (mxx - mnx) / zoom > box_w then
                box_w = (mxx - mnx) / zoom
                c_x = ((mnx + mxx) * 0.5 - ox0) / zoom
            end
            if math.abs(f_y) < 0.8 and (mxy - mny) / zoom > box_h then
                box_h = (mxy - mny) / zoom
                c_y = ((mny + mxy) * 0.5 - oy0) / zoom
            end
            if math.abs(f_z) < 0.8 and (mxz - mnz) / zoom > box_d then
                box_d = (mxz - mnz) / zoom
                c_z = ((mnz + mxz) * 0.5 - oz0) / zoom
            end
        end
    end

    -- 進行方向に沿った領域の半径と、横切る距離
    local hw = box_w * 0.5
    local hh = box_h * 0.5
    local hd = box_d * 0.5
    local support = math.abs(d_x) * hw + math.abs(d_y) * hh + math.abs(d_z) * hd
    if support < 1 then support = 1 end
    local travel = 2 * support

    c_d = ((c_x * ozm + ox0) - cam_x) * f_x
        + ((c_y * ozm + oy0) - cam_y) * f_y
        + ((c_z * ozm + oz0) - cam_z) * f_z
    local fade_d0 = c_d - (box_d * ozm) * 0.5
    local fade_span = box_d * ozm
    if fade_span < 1 then fade_span = 1 end

    ------------------------------------------------------------
    -- 粒子の計算
    --   位置は「時間 t の純関数」として求めるため、シークや
    --   途中からの再生でも同じ結果になる。
    ------------------------------------------------------------
    local t = obj.time
    local parts = {}

    for i = 0, num - 1 do
        local r_ph = rand01(i, 0, 1)   -- 周期内の位相
        local r_sz = rand01(i, 0, 2)   -- 大きさ
        local r_sp = rand01(i, 0, 3)   -- 移動速度
        local r_sw = rand01(i, 0, 4)   -- 揺らぎ
        local r_ro = rand01(i, 0, 5)   -- 回転

        -- 初速のばらつき（円錐の広がり係数）
        local vk = 0.6 + 0.8 * r_sp

        -- 進行方向成分（初速＋風）。風で速くなる分も寿命に反映する
        local w_d = wind_x * d_x + wind_y * d_y + wind_z * d_z
        local v_d = vel_len * vk + w_d
        local hw2 = 0
        if v_d > 0 then hw2 = v_d end

        -- 寿命（自動のときは「進行方向に領域を横切る時間」）
        local life
        if P.auto_life then
            if acc_d >= 0 then
                if acc_d > 1e-6 then
                    life = (math.sqrt(hw2 * hw2 + 2 * acc_d * travel) - hw2) / acc_d
                elseif hw2 > 1e-6 then
                    life = travel / hw2
                else
                    life = 1
                end
            else
                -- 進行方向に対して減速する（上向きの雪・下向きの重力 など）
                local dec = -acc_d
                local t_turn = hw2 / dec
                local d_turn = hw2 * hw2 / (2 * dec)
                if d_turn >= travel then
                    local disc = hw2 * hw2 - 2 * dec * travel
                    if disc > 0 then
                        life = (hw2 - math.sqrt(disc)) / dec
                    else
                        life = t_turn
                    end
                else
                    life = 2 * t_turn
                end
            end
        else
            life = P.life
        end
        if life < 0.05 then life = 0.05 end

        -- 進行方向に実際に進める距離（cover）
        --   重力で減速して途中で折り返す場合、領域を横切りきれず
        --   発生面の近くにしか粒子が存在しなくなる。その場合は
        --   発生位置を領域全体にばらまいて密度を均一にする。
        local cover
        if acc_d < 0 then
            local dec = -acc_d
            local d_turn = 0
            if v_d > 0 then d_turn = v_d * v_d / (2 * dec) end
            local t_turn = 0
            if v_d > 0 then t_turn = v_d / dec end
            if v_d > 0 and life >= t_turn then
                cover = d_turn          -- 途中で折り返す
            else
                cover = v_d * life + 0.5 * acc_d * life * life
            end
        else
            cover = v_d * life + 0.5 * acc_d * life * life
        end
        if cover < 0 then cover = 0 end
        if cover > travel then cover = travel end

        -- 周期内の年齢
        local tt = t + r_ph * life
        local cyc = math.floor(tt / life)
        local u = tt - cyc * life

        -- 世代ごとの乱数（繰り返しのたびに位置が変わる）
        local q_x = (rand01(i, cyc, 11) - 0.5) * box_w
        local q_y = (rand01(i, cyc, 12) - 0.5) * box_h
        local q_z = (rand01(i, cyc, 14) - 0.5) * box_d

        -- 開始位置
        --   領域を横切りきれる場合は「進行方向の入口面」から発生させる
        --   （初速Y=+200 なら従来どおり領域の上面から降ってくる）。
        --   折り返しなどで横切りきれない場合は、進行方向の軸に沿って
        --   領域全体へ均等にばらまく（入口面だけだと密度が偏る）。
        local along = q_x * d_x + q_y * d_y + q_z * d_z
        local s_x, s_y, s_z
        if wrapping then
            -- 折り返し中は「箱の中に一様」に置く
            --   入口面から出すと、動きの向きと箱の軸がずれているときに
            --   箱の中へ斜めの板が周期的に折り込まれ、密度の空洞
            --   （＝横一直線の「断层」）ができる。
            --   一様な分布は、等速で動かして折り返しても一様なままなので、
            --   どの向きから見てもムラが出ない。
            s_x = a_x + q_x
            s_y = a_y + q_y
            s_z = a_z + q_z
        elseif cover >= travel - 1e-6 then
            local push = along + support
            s_x = a_x + q_x - d_x * push
            s_y = a_y + q_y - d_y * push
            s_z = a_z + q_z - d_z * push
        else
            local room = travel - cover
            local t01 = (along + support) / travel
            local b = -support + t01 * room
            local px = q_x - d_x * along      -- 進行方向に垂直な成分
            local py = q_y - d_y * along
            local pz = q_z - d_z * along
            s_x = a_x + px + d_x * b
            s_y = a_y + py + d_y * b
            s_z = a_z + pz + d_z * b
        end

        -- 初速（初速ベクトル + 円錐状のばらつき + 風）
        local sp_ang = rand01(i, cyc, 13) * 2 * math.pi
        local sp_c = math.cos(sp_ang) * vel_len * spread_k
        local sp_s = math.sin(sp_ang) * vel_len * spread_k
        local vx = vel0_x * vk + e1_x * sp_c + e2_x * sp_s + wind_x
        local vy = vel0_y * vk + e1_y * sp_c + e2_y * sp_s + wind_y
        local vz = vel0_z * vk + e1_z * sp_c + e2_z * sp_s + wind_z

        -- 位置（等加速度運動＋揺らぎ）
        --   加速度は (0, grav, 0)。grav が負なら上向きに加速する。
        local sw_ph = r_sw * 2 * math.pi
        local sw_w = sway_w * (0.6 + 0.8 * r_sw)
        local p_x = s_x + vx * u + sway_amp * math.sin(sw_w * u + sw_ph)
        local p_y = s_y + vy * u + 0.5 * grav * u * u
        local p_z = s_z + vz * u + sway_amp * 0.6 * math.sin(sw_w * 0.83 * u + sw_ph * 1.7)

        -- 透明度（出現／消滅のフェード）
        local fr = u / life

        -- 粒の大きさ（折り返しのフェード幅にも使う）
        local sz = base_size * (1 - var_size + 2 * var_size * r_sz)
        sz = sz * (0.7 + 0.3 * math.sin(math.pi * fr))

        -- 世界固定モード：カメラ中心の箱へ折り返す
        --   （軌道そのものは世界座標のまま。箱を出たら反対側へ移動）
        local e_fade = 1
        if wrapping then
            local rel_x = p_x - c_x
            local rel_y = p_y - c_y
            local rel_z = p_z - c_z
            p_x = p_x - math.floor(rel_x / box_w + 0.5) * box_w
            p_y = p_y - math.floor(rel_y / box_h + 0.5) * box_h
            p_z = p_z - math.floor(rel_z / box_d + 0.5) * box_d

            local ddx = hw - math.abs(p_x - c_x)
            local ddy = hh - math.abs(p_y - c_y)
            local ddz = hd - math.abs(p_z - c_z)

            -- 折り返し地点は「粒の直径に比例した幅」でふわっと消す
            --   壁は（同期オンなら）画面の外にあるので、ここは保険
            local bandw = sz * P.wrap_soft_k

            -- ただし「視線にほぼ平行な軸」だけは別扱い。
            --   その軸の壁はカメラの正面にあり、透視投影で縮んだ
            --   箱として画面の内側に写る。粒の大きさ程度の短い帯で
            --   消すと、その縮んだ箱の輪郭が一本の「分界线」になる。
            --   奥行き側は粒ではなく箱の深さに比例した長い帯で
            --   消し、壁のところでちょうど α=0 になるようにする。
            local bw_x, bw_y, bw_z = bandw, bandw, bandw
            local DEEP = 0.25
            bw_x = snow_axis_feather(f_x, bandw, box_w * DEEP)
            bw_y = snow_axis_feather(f_y, bandw, box_h * DEEP)
            bw_z = snow_axis_feather(f_z, bandw, box_d * DEEP)

            if bw_x > 0 and ddx < bw_x then
                local kk = ddx / bw_x
                if kk < 0 then kk = 0 end
                e_fade = e_fade * (kk * kk * (3 - 2 * kk))
            end
            if bw_y > 0 and ddy < bw_y then
                local kk = ddy / bw_y
                if kk < 0 then kk = 0 end
                e_fade = e_fade * (kk * kk * (3 - 2 * kk))
            end
            if bw_z > 0 and ddz < bw_z then
                local kk = ddz / bw_z
                if kk < 0 then kk = 0 end
                e_fade = e_fade * (kk * kk * (3 - 2 * kk))
            end
        end

        local a = e_fade
        if fr < fin then a = a * (fr / fin) end
        if fr > 1 - fout then a = a * ((1 - fr) / fout) end

        -- カメラからの奥行き（ローカル p をワールド座標へ戻してから計算）
        local d_x = (p_x * ozm + ox0) - cam_x
        local d_y = (p_y * ozm + oy0) - cam_y
        local d_z = (p_z * ozm + oz0) - cam_z
        local depth = d_x * f_x + d_y * f_y + d_z * f_z

        ----------------------------------------------------------
        -- 近景カット（レンズに近すぎる粒子を消す）
        --   ・ON のときは depth <= 0（カメラの後ろ）も消える
        --   ・しきい値で「いきなり」消すと、粒子がしきい値の前後を
        --     行き来するたびに点滅して見える。そこで
        --       depth <= 近景カット距離        → α = 0
        --       depth >= 近景カット距離 × 1.6  → α = 1
        --     の間を smoothstep でつなぐ。
        --     位置は時間の連続関数なので、α も連続に変わる＝ちらつかない。
        --     （履歴を持つヒステリシスは使わない：シークで結果が
        --       変わってしまうため、このスクリプトの前提に反する）
        ----------------------------------------------------------
        local near_fade = 1
        if P.near_cull then
            local d0 = P.near_dist
            local d1 = d0 * 1.6
            if depth <= d0 then
                near_fade = 0
            elseif depth < d1 then
                local kk = (depth - d0) / (d1 - d0)
                near_fade = kk * kk * (3 - 2 * kk)
            end
            a = a * near_fade
        end
        -- OFF のときは何もしない（v1.13 までと同じ挙動）。
        --   後ろに回った粒子は AviUtl2 側のクリップに任せる。

        -- 奥行きによる減衰（航空写真的な霞み）
        if dfade > 0 then
            local k = (depth - fade_d0) / fade_span
            if k < 0 then k = 0 elseif k > 1 then k = 1 end
            a = a * (1 - dfade * k)
        end

        a = a * base_alpha
        if a > 0.001 then
            local rot = spin_v * t * (0.4 + 1.2 * r_ro) + r_ro * 2 * math.pi
            local bright = 0.85 + 0.3 * r_sz
            -- 乗算済み α：明るさ補正で 1 を超えないよう、α でクランプする
            local rr = col_r * bright * a
            local gg = col_g * bright * a
            local bb = col_b * bright * a
            if rr > a then rr = a end
            if gg > a then gg = a end
            if bb > a then bb = a end
            local a_fig = a * bright
            if a_fig > 1.0 then a_fig = 1.0 end
            parts[#parts + 1] = {
                p_x, p_y, p_z,            -- 位置
                sz,                       -- 大きさ
                rot,                      -- 回転角
                rr, gg, bb,               -- 色（乗算済みα）
                a,                        -- 透明度（CPU頂点色用）
                depth,                    -- 奥行き
                a_fig                     -- 図形テクスチャ有効α（bright反映済み）
            }
        end
    end

    ------------------------------------------------------------
    -- 奥→手前の順に並べ替え（半透明の重なりを正しくする）
    ------------------------------------------------------------
    if P.sort and #parts > 1 then
        table.sort(parts, function(p, q) return p[10] > q[10] end)
    end

    ------------------------------------------------------------
    -- 描画
    ------------------------------------------------------------
    -- 合成モードは「標準属性」の設定をそのまま使う
    --   （このオブジェクトからは obj.setoption("blend", …) を呼ばない）

    obj.setoption("culling", 0)
    obj.setoption("sampler", "clip")

    local nx, ny, nz = -f_x, -f_y, -f_z    -- 粒子法線（カメラ向き）

    -- エッジのぼかし（0=図形そのまま / >0=図形テクスチャをGPUでぼかす）
    local soft_v = P.soft / 100
    if soft_v < 0 then soft_v = 0 elseif soft_v > 1 then soft_v = 1 end
    if soft_v < 0.01 then soft_v = 0 end

    -- AviUtl2 標準の図形をテクスチャとして読み込む
    --   「純色」や読み込みに失敗した場合は、色付き多角形で代用する
    --   ぼかし使用時も同じ図形テクスチャを処理する
    local FIG_SIZE = 128
    local fig_ok = false
    if P.fig ~= nil and P.fig ~= "" then
        local ok = obj.load("figure", P.fig, P.color, FIG_SIZE)
        if ok == true then fig_ok = true end
    end

    -- v1.18 experiment: image-space filtering only; never drawpoly into a texture.
    local shape_scale_x, shape_scale_y = 1, 1
    local shape_blur_ok = false
    local shape_blur_failed = false
    if fig_ok and soft_v > 0 then
        local ok, result = pcall(function()
            local w, h = obj.getpixel()
            if type(w) ~= "number" or type(h) ~= "number" or w < 1 or h < 1 then return false end
            local sigma = math.max(0.15, soft_v * 24)
            local radius = math.min(72, math.ceil(sigma * 3))
            local pad = radius + 2
            local ow, oh = w + pad * 2, h + pad * 2
            if obj.copybuffer("cache:snow118/raw", "object") == false then return false end
            if obj.clearbuffer("cache:snow118/tmp", ow, oh) == false then return false end
            if obj.pixelshader("ps_snow_shape_blur", "cache:snow118/tmp",
                {"cache:snow118/raw"}, {w,h,ow,oh,0,sigma,radius,pad}, "copy") == false then return false end
            if obj.clearbuffer("object", ow, oh) == false then return false end
            if obj.pixelshader("ps_snow_shape_blur", "object",
                {"cache:snow118/tmp"}, {ow,oh,ow,oh,1,sigma,radius,pad}, "copy") == false then return false end
            shape_scale_x, shape_scale_y = ow / w, oh / h
            return true
        end)
        shape_blur_ok = ok and result == true
        shape_blur_failed = not shape_blur_ok
        if shape_blur_failed then
            -- Do not silently replace arbitrary figures by a circle.
            local loaded = obj.load("figure", P.fig, P.color, FIG_SIZE)
            fig_ok = loaded == true
            shape_scale_x, shape_scale_y = 1, 1
        end
    end

    ------------------------------------------------------------
    -- 描画先は常にフレームバッファ
    --   （仮想バッファに描くとオブジェクトの座標変換＝カメラの
    --     透視投影が効かなくなるため、3D のまま描く必要がある）
    ------------------------------------------------------------
    -- 描画先をフレームバッファへ戻す
    obj.setoption("drawtarget", "framebuffer")
    obj.setoption("culling", 0)

    local draw_verts = 0

    if fig_ok then
        ----------------------------------------------------------
        -- 図形テクスチャを貼ったビルボード
        --   drawpoly の透明度はポリゴンバッチ単位なので:
        --   ・「奥行き順に描画」ON 時: 奥→手前に並んだ粒子列を 8 層の深度スライスに分割し、
        --     各層内で有効 α（bright 反映済み）を 12 段階に量子化して奥の層から順に描画する。
        --   ・「奥行き順に描画」OFF 時: α バケットのみ（24 / 12 段階）で高速バッチ描画する。
        ----------------------------------------------------------
        local n_parts = #parts
        local n_strata = (P.sort and n_parts > 1) and math.min(8, n_parts) or 1
        local n_alpha  = P.sort and 12 or (shape_blur_ok and 24 or 12)
        local total_bk = n_strata * n_alpha
        local buckets = {}
        for b = 1, total_bk do
            buckets[b] = { list = {}, n = 0, dsum = 0, alpha_v = 1.0 }
        end

        for k = 1, n_parts do
            local p = parts[k]
            local p_x, p_y, p_z = p[1], p[2], p[3]
            local rs = p[4] * 0.5
            local rot = p[5]
            local a_eff = p[11] or p[9]
            local ca = math.cos(rot)
            local sa = math.sin(rot)
            local e_x = (r_x * ca + u_x * sa) * shape_scale_x
            local e_y = (r_y * ca + u_y * sa) * shape_scale_x
            local e_z = (r_z * ca + u_z * sa) * shape_scale_x
            local g_x = (-r_x * sa + u_x * ca) * shape_scale_y
            local g_y = (-r_y * sa + u_y * ca) * shape_scale_y
            local g_z = (-r_z * sa + u_z * ca) * shape_scale_y

            local st_idx = (n_strata > 1) and math.min(n_strata - 1, math.floor((k - 1) * n_strata / n_parts)) or 0
            local ab = math.floor(a_eff * n_alpha)
            if ab < 0 then ab = 0 elseif ab >= n_alpha then ab = n_alpha - 1 end
            local bk_idx = st_idx * n_alpha + ab + 1
            local bk = buckets[bk_idx]
            bk.alpha_v = (ab + 0.5) / n_alpha
            local li = #bk.list

            -- 左上 → 右上 → 右下 → 左下（カメラから見て時計回り）
            bk.list[li + 1] = { p_x - e_x * rs + g_x * rs,
                                p_y - e_y * rs + g_y * rs,
                                p_z - e_z * rs + g_z * rs, 0, 0 }
            bk.list[li + 2] = { p_x + e_x * rs + g_x * rs,
                                p_y + e_y * rs + g_y * rs,
                                p_z + e_z * rs + g_z * rs, 1, 0 }
            bk.list[li + 3] = { p_x + e_x * rs - g_x * rs,
                                p_y + e_y * rs - g_y * rs,
                                p_z + e_z * rs - g_z * rs, 1, 1 }
            bk.list[li + 4] = { p_x - e_x * rs - g_x * rs,
                                p_y - e_y * rs - g_y * rs,
                                p_z - e_z * rs - g_z * rs, 0, 1 }
            bk.n = bk.n + 1
            bk.dsum = bk.dsum + p[10]
        end

        -- 深度層 0（最奥）→ n_strata-1（最手前）の順に、各層内でも平均深度の深い順で描画
        for st = 0, n_strata - 1 do
            local order = {}
            local base_b = st * n_alpha
            for ab = 1, n_alpha do
                local b = base_b + ab
                if buckets[b].n > 0 then order[#order + 1] = b end
            end
            if #order > 1 then
                table.sort(order, function(x, y)
                    return buckets[x].dsum / buckets[x].n > buckets[y].dsum / buckets[y].n
                end)
            end
            for oi = 1, #order do
                local b = order[oi]
                local list = buckets[b].list
                local alpha_v = buckets[b].alpha_v
                for start = 1, #list, 6000 do
                    local chunk = {}
                    for j = start, math.min(start + 5999, #list) do chunk[#chunk+1] = list[j] end
                    obj.drawpoly(chunk, 4, alpha_v)
                    draw_verts = draw_verts + #chunk
                end
            end
        end
    else
        ----------------------------------------------------------
        -- 予備：色付きの円（図形が読めないとき）
        --   頂点色（乗算済みα）で描くので透明度は粒子ごとに正確
        --   ※ 最大 144,000 頂点を 5,400 頂点（1,800 三角形）単位で分割送信
        ----------------------------------------------------------
        local SEG = 12
        local verts = {}
        local vi = 0
        for k = 1, #parts do
            local p = parts[k]
            local p_x, p_y, p_z = p[1], p[2], p[3]
            local rs = p[4] * 0.5
            local rot = p[5]
            local rr, gg, bb, aa = p[6], p[7], p[8], p[9]
            local ca = math.cos(rot)
            local sa = math.sin(rot)
            local e_x = r_x * ca + u_x * sa
            local e_y = r_y * ca + u_y * sa
            local e_z = r_z * ca + u_z * sa
            local g_x = -r_x * sa + u_x * ca
            local g_y = -r_y * sa + u_y * ca
            local g_z = -r_z * sa + u_z * ca
            for j = 0, SEG - 1 do
                local a0 = 2 * math.pi * j / SEG
                local a1 = 2 * math.pi * (j + 1) / SEG
                local x1 = p_x + (e_x * math.cos(a0) + g_x * math.sin(a0)) * rs
                local y1 = p_y + (e_y * math.cos(a0) + g_y * math.sin(a0)) * rs
                local z1 = p_z + (e_z * math.cos(a0) + g_z * math.sin(a0)) * rs
                local x2 = p_x + (e_x * math.cos(a1) + g_x * math.sin(a1)) * rs
                local y2 = p_y + (e_y * math.cos(a1) + g_y * math.sin(a1)) * rs
                local z2 = p_z + (e_z * math.cos(a1) + g_z * math.sin(a1)) * rs
                vi = vi + 1
                verts[vi] = { p_x, p_y, p_z, rr, gg, bb, aa, nx, ny, nz }
                vi = vi + 1
                verts[vi] = { x2, y2, z2, rr, gg, bb, aa, nx, ny, nz }
                vi = vi + 1
                verts[vi] = { x1, y1, z1, rr, gg, bb, aa, nx, ny, nz }
            end
            if vi >= 5400 then
                obj.drawpoly(verts, 3)
                draw_verts = draw_verts + vi
                verts = {}
                vi = 0
            end
        end
        if vi > 0 then
            obj.drawpoly(verts, 3)
            draw_verts = draw_verts + vi
        end
    end


    ------------------------------------------------------------
    -- ログ出力（描画モードの可視化）
    --   AviUtl2 の「ログ」ウィンドウに、いま GPU 側のテクスチャ描画と
    --   CPU 側の頂点グラデーション描画のどちらで動いているかを出す。
    --   モードが変わったときだけ出力するのでログは溢れない。
    ------------------------------------------------------------
    pcall(function() obj.clearbuffer("cache:snow118/raw", 1, 1) end)
    pcall(function() obj.clearbuffer("cache:snow118/tmp", 1, 1) end)

    if P.log_mode then
        -- デバッグ機能なので、ここでエラーが出ても描画は止めない
        pcall(function()
            local ui_lang = snow_detect_ui_lang()

            local mode, desc_ja, desc_zh, desc_en, desc_de
            if shape_blur_ok then
                mode = "figure-blur(GPU-exp)"
                desc_ja = "図形を保持したGPUぼかし"
                desc_zh = "保留图形的GPU柔边"
                desc_en = "Shape-preserving GPU blur"
                desc_de = "Formerhaltende GPU-Weichzeichnung"
            elseif shape_blur_failed and fig_ok then
                mode = "figure-blur-FAILED"
                desc_ja = "ぼかし失敗：元の図形へ復帰"
                desc_zh = "柔边失败：已退回原始图形"
                desc_en = "Blur failed: original figure restored"
                desc_de = "Weichzeichnung fehlgeschlagen: Originalform"
            elseif fig_ok then
                mode = "figure-texture(GPU)"
                desc_ja = "図形テクスチャ（GPU サンプリング）"
                desc_zh = "图形纹理（GPU 采样）"
                desc_en = "Figure texture (GPU sampling)"
                desc_de = "Form-Textur (GPU-Sampling)"
            else
                mode = "flat-circle(CPU)"
                desc_ja = "単色円（図形の読み込みに失敗）"
                desc_zh = "纯色圆（图形加载失败）"
                desc_en = "Flat circle (figure load failed)"
                desc_de = "Einfarbiger Kreis (Form-Laden fehlgeschlagen)"
            end

            local t_now = obj.time or 0
            if type(t_now) ~= "number" then t_now = 0 end

            local log_key = mode .. ":" .. ui_lang
            local last_mode = _SNOW_PERSIST.last_mode
            local last_t = _SNOW_PERSIST.last_t or -1e9
            if type(global) == "table" and last_mode == nil then
                local pack = global.snow3d_log
                if type(pack) == "string" then
                    local m, ts = string.match(pack, "^([^|]*)|(.*)$")
                    if m ~= nil and m ~= "" then last_mode = m end
                    local tn = tonumber(ts)
                    if tn ~= nil then last_t = tn end
                end
            end

            local changed = (last_mode ~= log_key) or (t_now < last_t)
            if changed and (math.abs(t_now - last_t) > 0.5 or last_mode ~= log_key) then
                _SNOW_PERSIST.last_mode = log_key
                _SNOW_PERSIST.last_t = t_now
                if type(global) == "table" then
                    global.snow3d_log = string.format("%s|%.6f", log_key, t_now)
                end
                local near_txt = "OFF"
                if P.near_cull then near_txt = string.format("%.0f", P.near_dist) end
                local msg
                if ui_lang == "zh" then
                    msg = string.format(
                        "雪（3D）v1.22  模式=%s  粒子=%d  顶点=%d  模糊=%d  体积盒=%.0fx%.0fx%.0f  可视=%.0fx%.0f  近景裁剪=%s  →%s",
                        mode, #parts, draw_verts, P.soft, box_w, box_h, box_d, vis_w, vis_h, near_txt, desc_zh)
                elseif ui_lang == "de" then
                    msg = string.format(
                        "Schnee (3D) v1.22  Modus=%s  Partikel=%d  Verts=%d  Weich=%d  Box=%.0fx%.0fx%.0f  Sicht=%.0fx%.0f  Nahschnitt=%s  -> %s",
                        mode, #parts, draw_verts, P.soft, box_w, box_h, box_d, vis_w, vis_h, near_txt, desc_de)
                elseif ui_lang == "en" then
                    msg = string.format(
                        "Snow (3D) v1.22  mode=%s  particles=%d  verts=%d  soft=%d  box=%.0fx%.0fx%.0f  view=%.0fx%.0f  near=%s  -> %s",
                        mode, #parts, draw_verts, P.soft, box_w, box_h, box_d, vis_w, vis_h, near_txt, desc_en)
                else
                    msg = string.format(
                        "雪（3D）v1.22  mode=%s  粒子=%d  頂点=%d  ぼかし=%d  箱=%.0fx%.0fx%.0f  可視=%.0fx%.0f  近景=%s  →%s",
                        mode, #parts, draw_verts, P.soft, box_w, box_h, box_d, vis_w, vis_h, near_txt, desc_ja)
                end
                if mode == "flat-circle(CPU)" then
                    print("@warn", msg)
                else
                    print("@info", msg)
                end
            end
        end)
    end

------------------------------------------------------------
    -- 発生領域の枠（位置調整用の補助表示）
    ------------------------------------------------------------
    if P.show_box then
        local hx, hy, hz = box_w * 0.5, box_h * 0.5, box_d * 0.5
        local cx0, cx1 = c_x - hx, c_x + hx
        local cy0, cy1 = c_y - hy, c_y + hy
        local cz0, cz1 = c_z - hz, c_z + hz
        local thick = 2.0
        local verts = {}
        local vi = 0
        local function edge(ax, ay, az, bx, by, bz)
            local dx, dy, dz = bx - ax, by - ay, bz - az
            local ox = dy * nz - dz * ny
            local oy = dz * nx - dx * nz
            local oz = dx * ny - dy * nx
            local ol = math.sqrt(ox * ox + oy * oy + oz * oz)
            if ol < 1e-6 then
                -- 視線と平行な辺は右方向ベクトルとの外積で太さを付ける
                ox = dy * r_z - dz * r_y
                oy = dz * r_x - dx * r_z
                oz = dx * r_y - dy * r_x
                ol = math.sqrt(ox * ox + oy * oy + oz * oz)
            end
            if ol > 1e-6 then
                ox = ox / ol * thick * 0.5
                oy = oy / ol * thick * 0.5
                oz = oz / ol * thick * 0.5
                vi = vi + 1
                verts[vi] = {ax - ox, ay - oy, az - oz, 0.16, 0.56, 0.80, 0.8, nx, ny, nz}
                vi = vi + 1
                verts[vi] = {bx - ox, by - oy, bz - oz, 0.16, 0.56, 0.80, 0.8, nx, ny, nz}
                vi = vi + 1
                verts[vi] = {bx + ox, by + oy, bz + oz, 0.16, 0.56, 0.80, 0.8, nx, ny, nz}
                vi = vi + 1
                verts[vi] = {ax + ox, ay + oy, az + oz, 0.16, 0.56, 0.80, 0.8, nx, ny, nz}
            end
        end
        edge(cx0, cy0, cz0, cx1, cy0, cz0)
        edge(cx1, cy0, cz0, cx1, cy1, cz0)
        edge(cx1, cy1, cz0, cx0, cy1, cz0)
        edge(cx0, cy1, cz0, cx0, cy0, cz0)
        edge(cx0, cy0, cz1, cx1, cy0, cz1)
        edge(cx1, cy0, cz1, cx1, cy1, cz1)
        edge(cx1, cy1, cz1, cx0, cy1, cz1)
        edge(cx0, cy1, cz1, cx0, cy0, cz1)
        edge(cx0, cy0, cz0, cx0, cy0, cz1)
        edge(cx1, cy0, cz0, cx1, cy0, cz1)
        edge(cx1, cy1, cz0, cx1, cy1, cz1)
        edge(cx0, cy1, cz0, cx0, cy1, cz1)
        if vi > 0 then
            obj.drawpoly(verts, 4)
        end
    end

end

snow3d_frame()
